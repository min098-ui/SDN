# Kết nối tới PostgreSQL chạy qua Docker Compose (hoặc local PostgreSQL):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/demo_db?schema=public"

# Hoặc nếu dùng Cloud PostgreSQL (Neon.tech / Supabase miễn phí), chỉ cần dán URL vào đây:
# DATABASE_URL="postgresql://username:password@ep-sample-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

PORT=3001
